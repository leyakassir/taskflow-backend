generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  WORKER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(WORKER)
  isActive     Boolean  @default(true)
  avatarUrl    String?

  // Set when the password is reset with an emailed code. Sessions issued
  // before it are rejected, so a reset signs out every other device.
  passwordChangedAt DateTime?

  assignedTasks          Task[]              @relation("AssignedTasks")
  createdTasks           Task[]              @relation("CreatedTasks")
  reviewedTasks          Task[]              @relation("ReviewedTasks")
  deviceTokens           DeviceToken[]
  passwordResetCodes     PasswordResetCode[]
  refreshTokens          RefreshToken[]
  reviewedSignupRequests SignupRequest[]     @relation("SignupReviewer")
  notifications          Notification[]
  taskComments           TaskComment[]
  auditActions           AuditLog[]          @relation("AuditActor")
  auditTargets           AuditLog[]          @relation("AuditTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SignupRequestStatus {
  /// Waiting for the emailed code; admins don't see these.
  UNVERIFIED
  /// Email verified; waiting for an admin.
  PENDING
  APPROVED
  REJECTED
}

/// "Request an account" from the app. The email is verified with a code
/// before admins see it; approving creates the user with this password.
model SignupRequest {
  id              String              @id @default(cuid())
  email           String
  fullName        String
  passwordHash    String
  lang            String              @default("en")
  status          SignupRequestStatus @default(UNVERIFIED)
  codeHash        String?
  codeExpiresAt   DateTime?
  attempts        Int                 @default(0)
  verifiedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?               @relation("SignupReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?             @db.VarChar(300)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([email, createdAt])
  @@index([status, createdAt])
}

/// One-time code emailed for "Forgot password". Only a hash is stored.
model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Long-lived token the mobile app trades for a new 15-minute access
/// token (POST /auth/refresh). Only a SHA-256 hash is stored. Each use
/// replaces it with a new one; reusing a replaced token ends every session
/// of that user, since it means the token was copied.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NotificationKind {
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_UNASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_CANCELLED
  TASK_UPDATED
  TASK_SUBMITTED
  TASK_COMMENT
  DAILY_SUMMARY
  SIGNUP_REQUEST
  GENERIC
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String           @db.Text
  taskId    String?
  task      Task?            @relation(fields: [taskId], references: [id])
  readAt    DateTime?
  createdAt DateTime         @default(now())

  // Identifies the event this notification is about (e.g. "comment:<id>",
  // "due-24h:<taskId>:<deadline>"). One notification per user per event,
  // so repeated jobs, retries and restarts never send duplicates.
  dedupeKey String

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([taskId])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

model Task {
  id            String       @id @default(uuid())
  title         String
  description   String?
  // Optional Arabic versions shown by the app when its language is Arabic.
  titleAr       String?
  descriptionAr String?      @db.Text
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(ASSIGNED)

  deadline  DateTime?
  startDate DateTime?

  location String?

  // completion requirements set by the admin at creation time
  minPhotosRequired Int     @default(0)
  minFilesRequired  Int     @default(0)
  requiresChecklist Boolean @default(false)

  assigneeId String?
  assignee   User?   @relation("AssignedTasks", fields: [assigneeId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id])

  checklistItems TaskChecklistItem[]
  attachments    TaskAttachment[]
  notifications  Notification[]
  comments       TaskComment[]

  completionNotes     String?
  completionTimestamp DateTime?

  // Set when the reminder job moves the task to OVERDUE. Stops the job from
  // re-marking a task the worker restarted (OVERDUE -> IN_PROGRESS); cleared
  // when the deadline changes.
  markedOverdueAt DateTime?

  // Set when the worker submits; null on tasks completed before reviews existed.
  reviewStatus ReviewStatus?
  reviewNote   String?       @db.Text
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?         @relation("ReviewedTasks", fields: [reviewedById], references: [id])

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@index([deadline])
  @@index([assigneeId, deadline])
}

model TaskChecklistItem {
  id     String  @id @default(uuid())
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label  String
  done   Boolean @default(false)

  @@index([taskId])
}

model TaskAttachment {
  id     String @id @default(uuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // set by the admin (instructions) or by the worker (completion evidence)
  kind      TaskAttachmentKind
  url       String
  mimeType  String
  sizeBytes Int

  createdAt DateTime @default(now())

  @@index([taskId])
}

enum TaskAttachmentKind {
  INSTRUCTION
  COMPLETION_PHOTO
  COMPLETION_FILE
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([taskId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum AuditAction {
  TASK_CREATED
  TASK_UPDATED
  TASK_REASSIGNED
  TASK_STARTED
  TASK_STATUS_CHANGED
  TASK_CANCELLED
  TASK_DELETED
  TASK_SUBMITTED
  TASK_APPROVED
  TASK_SENT_BACK
  CHECKLIST_ITEM_ADDED
  CHECKLIST_ITEM_RENAMED
  CHECKLIST_ITEM_REMOVED
  ATTACHMENT_UPLOADED
  ATTACHMENT_REMOVED
  USER_CREATED
  USER_UPDATED
  USER_PASSWORD_RESET
  USER_PASSWORD_CHANGED
  USER_ACTIVATED
  USER_DEACTIVATED
  LEGAL_PAGE_UPDATED
}

// Who did what. details keeps a snapshot of names/titles.
model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction

  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  targetUserId String?
  targetUser   User?   @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
}
